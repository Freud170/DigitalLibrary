# Vorlage: als ".env" kopieren und ausfüllen. Die echte .env wird von Git ignoriert.

# Steam (erst für den Steam-Import nötig)
# Key holen: https://steamcommunity.com/dev/apikey (Domain: localhost)
STEAM_API_KEY=
# SteamID64 (17-stellige Zahl, Steam-Client → Kontodetails)
STEAM_ID=

# Optional – Standardwerte stehen in digitallibrary/config.py
# DATENBANK=daten/bibliothek.db
# HOST=127.0.0.1
# PORT=8000
